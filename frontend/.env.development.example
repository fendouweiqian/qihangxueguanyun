# 本地开发默认关闭接口加密、WebSocket 和 SSE
VITE_APP_ENCRYPT = false
VITE_APP_RSA_PUBLIC_KEY = 'CHANGE_ME_RSA_PUBLIC_KEY'
VITE_APP_RSA_PRIVATE_KEY = 'CHANGE_ME_RSA_PRIVATE_KEY'
VITE_APP_CLIENT_ID = 'CHANGE_ME_CLIENT_ID'
VITE_APP_WEBSOCKET = false
VITE_APP_SSE = false
