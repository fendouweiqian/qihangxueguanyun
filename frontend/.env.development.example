# 页面标题
VITE_APP_TITLE = 启航学管云
VITE_APP_LOGO_TITLE = 启航学管云

# 本地开发配置
VITE_APP_ENV = 'development'
VITE_APP_BASE_API = '/dev-api'
VITE_APP_CONTEXT_PATH = '/'
VITE_APP_API_PROXY_TARGET = 'http://127.0.0.1:8281'
